// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WalletEntry {
  id        String   @id @default(cuid())
  address   String   @unique // always lowercase
  tier      Tier
  maxAlloc  Int // per-phase override
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Tier {
  GTD_FREE  // access: GTD_FREE, GTD_MINT, WL_FCFS, PUBLIC
  GTD_MINT  // access: GTD_MINT, WL_FCFS, PUBLIC
  WL        // access: WL_FCFS, PUBLIC
}
